# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local configuration
.env
.env.*
.streamlit/secrets.toml

# Local datasets
data/**
!data/
!data/**/
!data/**/.gitkeep

# Vector store artifacts
vector_store/**
!vector_store/
!vector_store/.gitkeep

# RAG scraper debug dumps
docs/shinhan_faq/_debug_*.xml
docs/shinhan_faq/_debug_*.json

# Notebook checkpoints
.ipynb_checkpoints/

# Model and experiment artifacts
ml_model/outputs/**
!ml_model/outputs/
!ml_model/outputs/**/
!ml_model/outputs/**/*.md

# Common generated ML files outside outputs
*.pkl
*.pickle
*.joblib
*.model
*.onnx

# Logs and temporary files
*.log
*.tmp
*.bak
~$*
